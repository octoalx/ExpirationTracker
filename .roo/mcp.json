{
	"mcpServers": {
		"searxng": {
			"command": "npx",
			"args": [
				"-y",
				"mcp-searxng"
			],
			"env": {
				"SEARXNG_URL": "http://127.0.0.1:8080"
			},
			"disabled": false,
			"alwaysAllow": [
				"web_url_read",
				"searxng_web_search"
			]
		},
		"shadcn": {
			"command": "npx",
			"args": [
				"shadcn@latest",
				"mcp"
			]
		},
		"Adobe Spectrum": {
			"command": "npx",
			"args": [
				"@adobe/spectrum-design-data-mcp@latest"
			]
		},
		"framer": {
			"command": "npx",
			"args": [
				"-y",
				"mcp-remote",
				"https://mcp.unframer.co/mcp?id=47c1cde6379708ecf555677a529cb3415b7dce95f3ead7b77aa49effb5a9ec52&secret=yiD50xTZ2emOHlXM31eTXOuh8uwEgfBO"
			],
			"disabled": true,
			"alwaysAllow": []
		},
		"puppeteer": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-puppeteer"
			]
		}
	}
}