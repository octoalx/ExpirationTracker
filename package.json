    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.13",
    "react": "^18",
    "react-dom": "^18",
    "sqlite3": "^5.1.7",
    "telegraf": "^4.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.3",
