datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String  @id @default(cuid())
  notifyDaysBefore   Int     @default(5)
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPass           String?
  telegramChatId     String?
}

model Product {
  id               String   @id @default(cuid())
  name             String
  productionDate   DateTime
  expirationDate   DateTime
}
