datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  products      Product[]
  catalogEntries CatalogEntry[]
  settings      Settings?
  membership    StoreMembership?
  telegramLink  TelegramLink?
  telegramLinkRequest TelegramLinkRequest?
}

model CatalogEntry {
  id        String   @id @default(cuid())
  barcode   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, barcode])
}

model SharedCatalogEntry {
  id        String   @id @default(cuid())
  barcode   String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id         String   @id @default(cuid())
  name       String
  barcode    String   // Убрал @unique, чтобы не блокировать добавление одинаковых товаров
  expiryDate DateTime?
  manufacturingDate String?
  shelfLife Int?
  shelfLifeUnit String?
  status     String   @default("ACTIVE") // ACTIVE, ARCHIVED, DEFECT
  isExpired          Boolean   @default(false)   // Авто-флаг просрочки
  quantity           Int?                         // Опциональное количество
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  storeId    String?
  store      Store?   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  version    Int      @default(0)
  resolution String?
  missing    Boolean  @default(false)
  checkedAt  DateTime?
  checkedBy  String?
  deletedAt  DateTime?
  claim      ProductClaim?
  events     ProductEvent[]

  // Позволяет одному пользователю иметь несколько одинаковых товаров с разными датами,
  // но защищает от дубликатов при случайном двойном клике.
  @@index([userId])
  @@index([barcode])
  @@index([status])
  @@index([storeId, status])
}

model Store {
  id               String @id
  name             String
  urgentThreshold  Int @default(3)
  warningThreshold Int @default(7)
  members          StoreMembership[]
  products         Product[]
}

model StoreMembership {
  id        String @id @default(cuid())
  storeId   String
  userId    String @unique
  role      String @default("EMPLOYEE")
  createdAt DateTime @default(now())
  store     Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductClaim {
  productId String @id
  userId    String
  expiresAt DateTime
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductEvent {
  id        String @id @default(cuid())
  productId String?
  storeId   String?
  actorId   String
  actorName String
  source    String
  action    String
  details   String
  key       String @unique
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([storeId, createdAt])
}

model TelegramLink {
  userId         String @id
  telegramUserId String @unique
  chatId         String
  displayName    String
  deliveryStatus String @default("READY")
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLinkRequest {
  userId         String @id
  tokenHash      String @unique
  expiresAt      DateTime
  telegramUserId String?
  chatId         String?
  displayName    String?
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramButton {
  id        String @id
  userId    String
  payload   String
  expiresAt DateTime
}

model TelegramUpdate {
  id         Int @id
  payload    String
  state      String @default("QUEUED")
  attempts   Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  createdAt  DateTime @default(now())
}

model TelegramDelivery {
  id          String @id @default(cuid())
  key         String @unique
  userId      String
  kind        String
  scheduleDate String
  state       String @default("QUEUED")
  attempts    Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil  DateTime?
  messageId   String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  @@index([state, availableAt])
}

model TelegramWarning {
  id          String @id @default(cuid())
  userId      String
  productId   String
  fingerprint String
  @@unique([userId, productId])
}

model IntegrationState {
  id     String @id
  paused Boolean @default(false)
}

model Settings {
  id                     String  @id @default(cuid())
  userId                 String  @unique // Обязательно для связи 1-к-1 и работы upsert
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Telegram интеграция
  telegramToken          String?
  telegramChatId         String?
  telegramNotifications  Boolean @default(false)

  // Email/SMTP интеграция
  notificationEmail      String?
  emailNotifications     Boolean @default(false)
  smtpHost               String?
  smtpPort               Int?    @default(587)
  smtpUser               String?
  smtpPass               String?

  // Настройки логики уведомлений
  urgentThreshold        Int     @default(3) // Порог "Критично" (красный цвет)
  warningThreshold       Int     @default(7) // Порог "Внимание" (желтый цвет)
  urgentNotifyTime       String  @default("10:00") // Время ежедневного отчёта "Срочно" (HH:mm)
  warningNotifyTime      String  @default("10:00") // Время разового уведомления "Внимание" (HH:mm)

  // Настройки бэкапа
  backupTime             String  @default("03:00") // Время ежедневного бэкапа (HH:mm)
  backupEnabled          Boolean @default(true)

}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String   // e.g., 'INFO', 'WARN', 'ERROR'
  message   String
  meta      String?    // Optional structured data
}

model EmailLog {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  userId     String?
  to         String
  subject    String
  status     String    @default("QUEUED") // QUEUED | SENT | FAILED
  messageId  String?
  error      String?
  retryCount Int       @default(0)
  sentAt     DateTime?
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
