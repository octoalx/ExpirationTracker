datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // USER or ADMIN
  accounts      Account[]
  sessions      Session[]
  products      Product[]
  settings      Settings?
}

model Product {
  id         String   @id @default(cuid())
  name       String
  barcode    String   // Убрал @unique, чтобы не блокировать добавление одинаковых товаров
  expiryDate DateTime
  status     String   @default("ACTIVE") // ACTIVE, ARCHIVED, DEFECT
  isExpired          Boolean   @default(false)   // Авто-флаг просрочки
  quantity           Int?                         // Опциональное количество
  warningNotifiedAt  DateTime?                    // Дата отправки разового уведомления "Внимание"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Позволяет одному пользователю иметь несколько одинаковых товаров с разными датами,
  // но защищает от дубликатов при случайном двойном клике.
  @@index([userId])
  @@index([barcode])
  @@index([status])
}

model Settings {
  id                     String  @id @default(cuid())
  userId                 String  @unique // Обязательно для связи 1-к-1 и работы upsert
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Telegram интеграция
  telegramToken          String?
  telegramChatId         String?
  telegramNotifications  Boolean @default(true)

  // Email/SMTP интеграция
  notificationEmail      String?
  emailNotifications     Boolean @default(false)
  smtpHost               String?
  smtpPort               Int?    @default(587)
  smtpUser               String?
  smtpPass               String?

  // Настройки логики уведомлений
  notifyBeforeExpiration Int     @default(3) // За сколько дней начать слать уведомления
  urgentThreshold        Int     @default(3) // Порог "Критично" (красный цвет)
  warningThreshold       Int     @default(7) // Порог "Внимание" (желтый цвет)

  // Интерфейс
  theme                  String  @default("light")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SystemLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String   // e.g., 'INFO', 'WARN', 'ERROR'
  message   String
  meta      String?    // Optional structured data
}

model EmailLog {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  userId     String?
  to         String
  subject    String
  status     String    @default("QUEUED") // QUEUED | SENT | FAILED
  messageId  String?
  error      String?
  retryCount Int       @default(0)
  sentAt     DateTime?
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
