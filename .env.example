# Database
DATABASE_URL="file:/app/data/dev.db"

# NextAuth — REQUIRED for production!
# Generate: openssl rand -base64 32
# For localhost: http://localhost:8881
# For custom domain: https://expitracker.local
NEXTAUTH_URL="http://localhost:8881"
NEXTAUTH_SECRET=""

# SMTP, Telegram, and notification thresholds are configured per-user
# in the app via Settings → Notifications (stored in database)
