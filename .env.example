# Database
# Set to true for isolated development/build checks without cron side effects.
DISABLE_BACKGROUND_JOBS="false"
DATABASE_URL="file:/app/data/dev.db"

# NextAuth — REQUIRED for production!
# Generate: openssl rand -base64 32
# For localhost: http://localhost:8881
# For custom domain: https://expitrack.local
NEXTAUTH_URL="http://localhost:8881"
NEXTAUTH_SECRET=""

# Optional isolated build output; leave unset for normal development/deployment.
# NEXT_DIST_DIR=".verification/release-build"

# Cloudflare Tunnel
TUNNEL_TOKEN=""

# Shared Telegram bot. Never use NEXT_PUBLIC_ for these values.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# SMTP and notification times are configured per-user in Settings.
# Store risk thresholds are managed by the store manager.
